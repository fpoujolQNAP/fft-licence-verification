{
  "manifest_version": 3,
  "name": "TenUp - Recherche Licenciés FFT",
  "version": "1.3.0",
  "description": "Recherche en lot de licenciés FFT sur Ten'Up : classement, club, palmarès. Export CSV. Connexion tenup.fft.fr requise.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://tenup.fft.fr/*"
  ],
  "action": {
    "default_title": "TenUp - Recherche Licenciés FFT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/florianpoujol/tenup-recherche",
  "minimum_chrome_version": "111"
}
